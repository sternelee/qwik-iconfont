{
  "name": "qwik-iconfont",
  "description": "Demo app with sample routes",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.server": "qwik check-client src dist && vite build -c adapters/cloudflare-workers/vite.config.ts && node scripts/fix-worker-import.mjs",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --incremental --noEmit",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply iconfont-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply iconfont-db --remote",
    "deploy": "wrangler deploy",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "preview:wrangler": "pnpm build && wrangler dev",
    "serve": "wrangler dev",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@cloudflare/workers-types": "^4.20260526.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "25.9.1",
    "@xmldom/xmldom": "^0.9.10",
    "daisyui": "^5.5.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.4.0",
    "eslint-plugin-qwik": "^1.20.0",
    "globals": "17.6.0",
    "jszip": "^3.10.1",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "typescript-plugin-css-modules": "latest",
    "undici": "^8.3.0",
    "vite": "8.0.14",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.94.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "opentype.js": "^2.0.0",
    "svg2ttf": "^6.1.0",
    "svgpath": "^2.6.0"
  }
}
