{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iconfont",
  "main": "./dist/_worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSET",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },

  // ── Cloudflare 资源绑定 ─────────────────────────────────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iconfont-db",
      "database_id": "c8aedf62-0870-451b-8de4-b4411fffb50d", // wrangler d1 create iconfont-db → 复制此处
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "iconfont-assets", // wrangler r2 bucket create iconfont-assets
    },
  ],

  // ── 环境变量 ────────────────────────────────────────────────────────────────
  // 敏感变量（Secret）推荐用 `wrangler secret put` 设置，避免明文提交。
  // 本地开发时在 .dev.vars 文件中覆盖（已加入 .gitignore）。
  "vars": {
    // ── 必填：认证 ──────────────────────────────────────────────────────────
    // 应用公开 URL，用于 OAuth 回调和邮件链接
    // 本地开发：http://localhost:8788，生产：https://iconfont.example.com
    "BETTER_AUTH_URL": "https://iconfont.leeapp.dev",

    // Session 签名密钥，随机字符串（生产环境请用 wrangler secret put BETTER_AUTH_SECRET）
    "BETTER_AUTH_SECRET": "6e44f39d487063af877b296e7cf8a3761440fd5d7ca889f8c4b3df49032d44b3",

    // ── 可选：GitHub OAuth ────────────────────────────────────────────────
    // 创建地址：https://github.com/settings/developers → OAuth Apps
    // Callback URL：<BETTER_AUTH_URL>/api/auth/callback/github
    "GITHUB_CLIENT_ID": "",
    "GITHUB_CLIENT_SECRET": "",

    // ── 可选：Google OAuth ────────────────────────────────────────────────
    // 创建地址：https://console.cloud.google.com → APIs & Services → Credentials
    // 授权重定向 URI：<BETTER_AUTH_URL>/api/auth/callback/google
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_CLIENT_SECRET": "",

    // ── 可选：邮件服务（Resend）──────────────────────────────────────────
    // 注册地址：https://resend.com — 用于发送注册欢迎邮件
    // 留空则跳过发送，不影响注册流程
    "RESEND_API_KEY": "",
    "EMAIL_FROM": "noreply@iconfont.app",

    // ── 可选：GitHub Token ────────────────────────────────────────────────
    // 用于 GitHub 图标库导入：未配置 60次/小时，配置后 5000次/小时
    // 创建地址：https://github.com/settings/tokens（read:packages 权限即可）
    "GITHUB_TOKEN": "",

    // ── 可选：AI 图标生成（OpenAI 兼容 API）──────────────────────────────
    // 配置后可在项目页面使用「✨ AI 生成」功能生成 SVG 图标
    // 支持 OpenAI、Together、Groq、Ollama 等兼容接口
    // 本地开发：在 .dev.vars 中设置 OPENAI_API_KEY（已加入 .gitignore）
    "OPENAI_API_KEY": "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",
    "OPENAI_BASE_URL": "https://openrouter.ai/api/v1",
    "AI_MODEL": "stepfun/step-3.7-flash",
  },

  // ── 可选：Cloudflare Workers AI（替代 OpenAI）──────────────────────────────
  // 启用后无需 API Key，使用 Cloudflare 托管模型（按用量计费）
  // 取消注释以启用，并确保账户已开通 Workers AI
  // "ai": {
  //   "binding": "AI",
  // },
}
