# .dev.vars — 本地开发环境变量（覆盖 wrangler.jsonc 中的 vars）
# 此文件已加入 .gitignore，不会提交到 Git。
# 参考 .dev.vars.example 创建此文件，或直接复制并填入真实值。

BETTER_AUTH_URL=http://localhost:8788
BETTER_AUTH_SECRET=6e44f39d487063af877b296e7cf8a3761440fd5d7ca889f8c4b3df49032d44b3

# GitHub OAuth（本地测试 OAuth 流程时填写）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth（本地测试 OAuth 流程时填写）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend 邮件（留空则跳过发送）
RESEND_API_KEY=
EMAIL_FROM=noreply@iconfont.app

# GitHub Token（留空则 60次/小时限速）
GITHUB_TOKEN=
